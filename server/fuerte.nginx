server {
    listen 80;
    server_name fuerte.signalvise.com;
    location /.well-known/acme-challenge/ { root /var/www/fuerte-acme; }
    location / { return 301 https://fuerte.signalvise.com$request_uri; }
}
server {
    listen 443 ssl;
    server_name fuerte.signalvise.com;
    ssl_certificate /etc/letsencrypt/live/fuerte.signalvise.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fuerte.signalvise.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 32k;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:3500;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 110s;
    }
}
